    {
      "_id": "fb01c2c2369071fc",
      "name": "Brave",
      "type": "trait",
      "img": "icons/svg/upgrade.svg",
      "system": {
        "key": "brave",
        "traitType": "positive",
        "scope": "ego",
        "level": 1,
        "cost": 10,
        "costText": "Cost: 10 CP",
        "description": "<p>This character does not scare easily, and will face threats, intimidation, and certain bodily harm without flinching. As a side effect, the character is not always the best at gauging risks, especially when it comes to factoring in danger to others. The character receives a +10 modifier on all tests to resist fear or intimidation.</p><p><em>Source: Eclipse Phase Core Rulebook, p. 145.</em></p>"
      },
      "effects": [],
      "flags": {},
      "sort": 2000,
      "ownership": {
        "default": 0
      },
      "folder": null,
      "_key": "!actors.items!5c7d809b1513d3aa.fb01c2c2369071fc"
    },
    {
      "_id": "2009a7e6e8cc32b8",
      "name": "Mental Disorder",
      "type": "trait",
      "img": "icons/svg/downgrade.svg",
      "system": {
        "key": "mentalDisorder",
        "traitType": "negative",
        "scope": "ego",
        "level": 1,
        "cost": 10,
        "costText": "Bonus: 10 CP",
        "description": "<p>You have a psychological disorder from a previous traumatic experience in your life. Choose one of the disorders listed on p. 211.</p><p><em>Source: Eclipse Phase Core Rulebook, p. 150.</em></p>"
      },
      "effects": [],
