        "psiType": "gamma",
        "activation": "passive",
        "action": "automatic",
        "range": "self",
        "duration": "constant",
        "durationUnit": "turns",
        "strainMod": 0,
        "strainPerTarget": 0,
        "strainPerAP": false,
        "skill": "",
