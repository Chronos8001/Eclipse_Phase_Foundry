<div class="item-controls">
  <a class="summary-toggle" data-action="toggleSummary" data-tooltip="EP1E.Item.summary"><i class="fa-solid fa-chevron-down"></i></a>
  {{#if @root.editable}}
  <a data-action="editItem" data-tooltip="EP1E.Item.edit"><i class="fa-solid fa-pen-to-square"></i></a>
  <a data-action="deleteItem" data-tooltip="EP1E.Item.delete"><i class="fa-solid fa-trash"></i></a>
  {{else}}
  <a data-action="editItem" data-tooltip="EP1E.Item.view"><i class="fa-solid fa-eye"></i></a>
  {{/if}}
</div>
