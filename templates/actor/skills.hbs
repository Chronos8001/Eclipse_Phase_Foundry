<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="skills">
  <p class="hint">{{localize "EP1E.Skill.hint"}} {{localize "EP1E.Skill.orderHint"}}</p>
  <input class="skill-filter" type="search" placeholder="{{localize 'EP1E.Skill.filter'}}" aria-label="{{localize 'EP1E.Skill.filter'}}">
  {{#each skillGroups as |group|}}
  <section class="panel skills {{group.category}}">
    <header class="list-header">
      <h3>{{localize group.title}}</h3>
      {{#if @root.editable}}
      <span class="header-actions">
        {{#if @root.manualSkillOrder}}<a class="add" data-action="sortSkills" data-tooltip="EP1E.Skill.sortAlpha"><i class="fa-solid fa-arrow-down-a-z"></i></a>{{/if}}
        <a class="add" data-action="createSkill" data-category="{{group.category}}" data-tooltip="EP1E.Skill.add"><i class="fa-solid fa-plus"></i></a>
      </span>
      {{/if}}
    </header>
    <table class="skill-table">
      <thead>
        <tr>
          <th class="name">{{localize "EP1E.Skill.label"}}</th>
          <th>{{localize "EP1E.Skill.aptitude"}}</th>
          <th data-tooltip="EP1E.Skill.ranksHint">{{localize "EP1E.Skill.ranks"}}</th>
          <th>{{localize "EP1E.Skill.morph"}}</th>
          <th>{{localize "EP1E.Skill.mod"}}</th>
          <th>{{localize "EP1E.Skill.total"}}</th>
          <th class="spec">{{localize "EP1E.Skill.specialization"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each group.list as |row|}}
        <tr class="draggable {{#if row.item.system.defaulting}}defaulting{{/if}}" data-item-id="{{row.item.id}}">
          <td class="name">
            <a class="rollable" data-action="rollItem" data-tooltip="EP1E.Test.rollHint">{{row.item.name}}</a>
            {{#if row.hasField}}
            <input class="field-input" type="text" value="{{row.item.system.field}}" data-item-field="system.field" placeholder="{{localize 'EP1E.Skill.field'}}" {{#unless @root.editable}}disabled{{/unless}}>
            {{else if row.item.system.field}}: {{row.item.system.field}}{{/if}}
            {{#if row.item.system.noDefault}}<span class="no-default" data-tooltip="EP1E.Skill.noDefault">*</span>{{/if}}
          </td>
          <td class="apt">{{localize row.aptitudeAbbr}} <small>{{row.item.system.aptitudeValue}}</small></td>
          <td><input type="number" value="{{row.item.system.ranks}}" min="0" data-item-field="system.ranks" {{#unless @root.editable}}disabled{{/unless}}></td>
          <td class="derived">{{#if row.item.system.morphBonus}}{{ep1eSigned row.item.system.morphBonus}}{{/if}}{{#if row.item.system.effectBonus}} <span data-tooltip="EP1E.Skill.effectBonus">{{ep1eSigned row.item.system.effectBonus}}</span>{{/if}}</td>
          <td><input type="number" value="{{row.item.system.mod}}" data-item-field="system.mod" {{#unless @root.editable}}disabled{{/unless}}></td>
          <td class="total"><a class="rollable" data-action="rollItem">{{row.item.system.total}}</a></td>
          <td class="spec"><input type="text" value="{{row.item.system.specialization}}" data-item-field="system.specialization" {{#unless @root.editable}}disabled{{/unless}}></td>
          <td>{{> "systems/ep1e/templates/actor/parts/item-controls.hbs"}}</td>
        </tr>
        {{else}}
        <tr><td colspan="8" class="empty">{{localize "EP1E.Skill.none"}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </section>
  {{/each}}
</section>
