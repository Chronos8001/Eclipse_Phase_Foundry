<div class="form-grid">
  <div class="form-group">
    <label>{{localize "EP1E.Background.kindLabel"}}</label>
    <select name="system.kind">{{selectOptions config.backgroundKinds selected=system.kind localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Background.pp"}}</label>
    <input type="number" name="system.pp" value="{{system.pp}}" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Background.moxie"}}</label>
    <input type="number" name="system.moxie" value="{{system.moxie}}">
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Background.credit"}}</label>
    <input type="number" name="system.credit" value="{{system.credit}}">
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Background.rep"}}</label>
    <input type="number" name="system.rep" value="{{system.rep}}">
  </div>
</div>
{{#if system.skills.length}}
<div class="form-group stacked">
  <label>{{localize "EP1E.Background.skills"}}</label>
  <p>{{#each system.skills as |s|}}{{s.name}}{{#if s.field}}: {{s.field}}{{/if}} {{ep1eSigned s.value}}{{#unless @last}}, {{/unless}}{{/each}}</p>
</div>
{{/if}}
{{#if system.traits.length}}
<div class="form-group stacked">
  <label>{{localize "EP1E.Background.traits"}}</label>
  <p>{{#each system.traits as |t|}}{{t.name}}{{#if (gt t.level 1)}} ({{t.level}}){{/if}}{{#unless @last}}, {{/unless}}{{/each}}</p>
</div>
{{/if}}
<div class="form-group stacked">
  <label>{{localize "EP1E.Background.choices"}}</label>
  <input type="text" name="system.choices" value="{{system.choices}}">
</div>
<div class="form-group stacked">
  <label>{{localize "EP1E.Background.restrictions"}}</label>
  <input type="text" name="system.restrictions" value="{{system.restrictions}}">
</div>
<div class="form-group stacked">
  <label>{{localize "EP1E.Background.morphs"}}</label>
  <input type="text" name="system.morphs" value="{{system.morphs}}">
</div>
<p class="hint">{{localize "EP1E.Background.dropHint"}}</p>
