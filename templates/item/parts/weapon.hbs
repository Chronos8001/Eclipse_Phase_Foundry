<div class="form-grid">
  <div class="form-group">
    <label>{{localize "EP1E.Weapon.type"}}</label>
    <select name="system.weaponType">{{selectOptions config.weaponTypes selected=system.weaponType localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Weapon.skill"}}</label>
    <select name="system.skill">{{selectOptions skillChoices selected=system.skill}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Weapon.dv"}}</label>
    <input type="text" name="system.dv" value="{{system.dv}}" placeholder="2d10 + 2">
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Weapon.ap"}}</label>
    <input type="number" name="system.ap" value="{{system.ap}}" max="0">
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Weapon.damageType"}}</label>
    <select name="system.damageType">{{selectOptions config.damageTypes selected=system.damageType localize=true}}</select>
  </div>
  <div class="form-group">
    <label data-tooltip="EP1E.Weapon.addDBHint">{{localize "EP1E.Weapon.addDB"}}</label>
    <input type="checkbox" name="system.addDB" {{checked system.addDB}}>
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Weapon.modes"}}</label>
    <input type="text" name="system.modes" value="{{system.modes}}" placeholder="SA, BF, FA">
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Weapon.ammo"}}</label>
    <span class="pair">
      <input type="number" name="system.ammo.value" value="{{system.ammo.value}}" min="0">
      / <input type="number" name="system.ammo.max" value="{{system.ammo.max}}" min="0">
    </span>
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Weapon.range"}}</label>
    <input type="text" name="system.range" value="{{system.range}}" placeholder="10 / 30 / 50 / 70">
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Item.equipped"}}</label>
    <input type="checkbox" name="system.equipped" {{checked system.equipped}}>
  </div>
</div>
