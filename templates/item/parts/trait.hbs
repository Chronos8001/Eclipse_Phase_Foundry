<div class="form-grid">
  <div class="form-group">
    <label>{{localize "EP1E.Trait.type"}}</label>
    <select name="system.traitType">{{selectOptions config.traitTypes selected=system.traitType localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Trait.scope"}}</label>
    <select name="system.scope">{{selectOptions config.traitScopes selected=system.scope localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Trait.level"}}</label>
    <input type="number" name="system.level" value="{{system.level}}" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "EP1E.Trait.cost"}}</label>
    <input type="number" name="system.cost" value="{{system.cost}}" min="0">
  </div>
</div>
<div class="form-group stacked">
  <label>{{localize "EP1E.Trait.costText"}}</label>
  <input type="text" name="system.costText" value="{{system.costText}}">
</div>
<p class="hint">{{localize "EP1E.Trait.effectHint"}}</p>
