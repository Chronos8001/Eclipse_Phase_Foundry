<header class="sheet-header item-header">
  <img class="portrait" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img" data-tooltip="{{item.name}}">
  <div class="header-main">
    <input class="item-name" type="text" name="name" value="{{item.name}}" placeholder="{{localize 'EP1E.Item.name'}}">
    <span class="item-type">{{localize typeLabel}}</span>
  </div>
</header>
